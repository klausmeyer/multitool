{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>.+) registryUrls=(?<registryUrls>.+)\\sENV .+_VERSION=\"(?<currentValue>.+)\""
      ],
      "datasourceTemplate": "deb"
    }
  ]
}
